root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.{sh,cmake}]
indent_size = 4

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Interop: source-generated P/Invokes only (ADR 0001). Any [DllImport] fails the build.
dotnet_diagnostic.SYSLIB1054.severity = error

# Style (enforced in build via EnforceCodeStyleInBuild)
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Unused usings are reported only when documentation files are generated; keep them as suggestions.
dotnet_diagnostic.IDE0005.severity = suggestion

[tests/**.cs]
# xUnit convention: Method_Condition_Result names.
dotnet_diagnostic.CA1707.severity = none

[bench/**.cs]
# BenchmarkDotNet requires public, non-sealed benchmark classes.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1822.severity = none
