<Project>
  <!-- Central package versions. Sources: docs/research/versions.md (nuget.org, 2026-09-25). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- MIT, https://github.com/Giorgi/DuckDB.NET (nuget.org, 2026-09-25): history store; bundles native DuckDB (MIT). -->
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- MIT, https://github.com/Shane32/QRCoder (nuget.org, 2026-09-25): BankID QR code in the CLI only. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
