// Gross Warp: tempo-locked time and volume envelopes (gen~ DSP core).
//
// in1, in2    audio L, R
// in3         beat phase 0..1 from [phasor~ 4n @lock 1] (a quarter note of Live's transport)
// out1, out2  audio L, R
// out3        pattern phase 0..1, or -1 while the transport is stopped
// out4        the pattern now playing (0..7)
//
// Params set by the patcher: pattern, quant, patlen, smoothms, depth, wet, pitchlock, grainms; from the Live API:
// songbeats (song position in beats, arrives a little late), signum, sigden (time signature); from Gross Warp MIDI:
// trigon, trigoff (pattern + 8 * parity + 16 * mode, the parity alternating per event so repeats are seen), midien.
//
// Envelopes arrive in buffer~ gwenv (one channel, written by gw_ui.js):
//   block b = pattern * 2 + env (env 0 = time, 1 = volume), base = b * 385;
//   [base] = point count n (2..128), then n points (x, u, curve) at base + 1 + 3 * i.
//   x: 0..1 across the pattern, sorted; u: 0 at the top of the editor, 1 at the bottom;
//   curve: -1..1, the bend of the segment that starts at that point.
// Time:   read offset = u * depth * pattern length (u = 1 plays a whole pattern late).
// Volume: gain = 1 - u * depth.
// Pitch lock: two grains (sin^2 windows, half a grain apart) play at normal speed from where the time envelope is,
// so time warps without the pitch change.
//
// House rules for this file (gen~ is unforgiving and silent about some of them):
//   - peek() only as the whole right-hand side of an assignment, on its own line;
//   - no break and no compound assignment; loops stop through their condition;
//   - every variable is first set at top level, before any block that sets it;
//   - History is read into a local at the top and written at the end, nowhere else.

hermite(ym, y0, y1, y2, fr) {
    c1 = 0.5 * (y1 - ym);
    c2 = ym - 2.5 * y0 + 2 * y1 - 0.5 * y2;
    c3 = 0.5 * (y2 - ym) + 1.5 * (y0 - y1);
    return ((c3 * fr + c2) * fr + c1) * fr + y0;
}

Buffer gwenv("gwenv");
Buffer gwpeaks("gwpeaks");
Data gwring(2097152, 2);

Param pattern(0);
Param quant(4);
Param patlen(2);
Param smoothms(4);
Param depth(100);
Param wet(100);
Param pitchlock(0);
Param grainms(60);
Param songbeats(-1);
Param signum(4);
Param sigden(4);
Param trigon(-1);
Param trigoff(-1);
Param midien(0);

History hWpos(0);
History hPrevPh(0);
History hInc(0);
History hStill(100000);
History hBeatCnt(0);
History hSongPrev(-1);
History hQIdx(0);
History hSince(100000);
History hReqPrev(0);
History hAct(0);
History hTrig(-1);
History hTrigMode(0);
History hOnPrev(-1);
History hOffPrev(-1);
History hSegT(0);
History hSegV(0);
History hPrevTgt(0);
History hOldOff(0);
History hXf(1);
History hLock(0);
History hDir(1);
History hGPh(0);
History hGSA(0);
History hGSB(0);
History hGDA(1);
History hGDB(1);
History hGain(1);
History hBin(0);
History hPkIn(0);
History hPkOut(0);

ringLen = 2097152;
blockLen = 385;

// ---- state from the previous sample ----
wpos = hWpos;
prevPh = hPrevPh;
incEst = hInc;
stillN = hStill;
beatCnt = hBeatCnt;
songPrev = hSongPrev;
qIdxPrev = hQIdx;
sinceCross = hSince;
reqPrev = hReqPrev;
actPat = hAct;
trigCur = hTrig;
trigMode = hTrigMode;
onPrev = hOnPrev;
offPrev = hOffPrev;
segT = hSegT;
segV = hSegV;
prevTgt = hPrevTgt;
oldOff = hOldOff;
xfNow = hXf;
lockPrev = hLock;
dirPrev = hDir;
gPh = hGPh;
gSA = hGSA;
gSB = hGSB;
gDA = hGDA;
gDB = hGDB;
gainNow = hGain;
binNow = hBin;
pkIn = hPkIn;
pkOut = hPkOut;

// ---- transport: is the beat phase moving, how fast, and which beat of the song this is ----
beatPh = in3;
dPh = beatPh - prevPh;
wrapped = 0;
if (dPh < -0.5) {
    dPh = dPh + 1;
    wrapped = 1;
}
moving = 0;
if (dPh > 0.00000001 && dPh < 0.01) {
    moving = 1;
}
if (moving > 0) {
    if (incEst <= 0 || stillN >= 4096) {
        incEst = dPh;
    } else {
        incEst = incEst + (dPh - incEst) * 0.001;
    }
    stillN = 0;
    if (wrapped > 0) {
        beatCnt = beatCnt + 1;
    }
} else {
    stillN = min(stillN + 1, 100000);
}
// Live's song position arrives late; the nearest whole beat to (position - phase) is the right count either way.
if (songbeats != songPrev) {
    if (songbeats >= 0) {
        beatCnt = floor(songbeats - beatPh + 0.5);
    }
    songPrev = songbeats;
}
playing = 0;
if (stillN < 4096 && incEst > 0) {
    playing = 1;
}

// ---- meter, pattern length (in quarter notes) and phase ----
qpb = clamp(floor(signum + 0.5), 1, 32) * 4 / clamp(floor(sigden + 0.5), 1, 32);
lenSel = clamp(floor(patlen + 0.5), 0, 4);
patQ = qpb;
if (lenSel == 0) {
    patQ = 1;
}
if (lenSel == 1) {
    patQ = 2;
}
if (lenSel == 3) {
    patQ = qpb * 2;
}
if (lenSel == 4) {
    patQ = qpb * 4;
}
songPos = beatCnt + beatPh;
patPos = songPos / patQ;
patPh = patPos - floor(patPos);
beatSamps = 0;
if (incEst > 0) {
    beatSamps = 1 / incEst;
}
patSamps = beatSamps * patQ;

// ---- MIDI triggers: hold (0) plays a pattern while its note is down, latch (1) toggles it ----
tOn = 0;
tN = 0;
tNew = 0;
tOff = 0;
fN = 0;
if (trigon != onPrev) {
    if (trigon >= 0) {
        tOn = floor(trigon + 0.5);
        tN = tOn % 8;
        trigMode = floor(tOn / 16) % 2;
        tNew = tN;
        if (trigMode == 1 && trigCur == tN) {
            tNew = -1;
        }
        trigCur = tNew;
    }
    onPrev = trigon;
}
if (trigoff != offPrev) {
    if (trigoff >= 0) {
        tOff = floor(trigoff + 0.5);
        fN = tOff % 8;
        if (trigMode == 0 && trigCur == fN) {
            trigCur = -1;
        }
    }
    offPrev = trigoff;
}
if (midien < 0.5) {
    trigCur = -1;
}

// ---- pattern switching on the Switch grid (Instant, 1/16, Beat, Bar, Pattern) ----
reqPat = clamp(floor(pattern + 0.5), 0, 7);
if (trigCur >= 0) {
    reqPat = trigCur;
}
qMode = clamp(floor(quant + 0.5), 0, 4);
qUnit = patQ;
if (qMode == 1) {
    qUnit = 0.25;
}
if (qMode == 2) {
    qUnit = 1;
}
if (qMode == 3) {
    qUnit = qpb;
}
qIdx = floor(songPos / qUnit);
crossed = 0;
if (qIdx != qIdxPrev) {
    crossed = 1;
}
sinceCross = min(sinceCross + 1, 100000);
if (crossed > 0) {
    sinceCross = 0;
}
// A request that lands just after a grid line (a note on the beat, a little late) still takes that line.
graceS = mstosamps(40);
if (playing == 0 || qMode == 0) {
    actPat = reqPat;
}
if (playing > 0 && qMode > 0 && crossed > 0) {
    actPat = reqPat;
}
if (playing > 0 && qMode > 0 && reqPat != reqPrev && sinceCross < graceS) {
    actPat = reqPat;
}

// ---- time envelope of the active pattern ----
baseT = actPat * 2 * blockLen;
nT = peek(gwenv, baseT, 0);
nT = floor(nT);
uT = 0;
xs = 0;
xn = 0;
adv = 0;
k = 0;
x0 = 0;
u0 = 0;
c0 = 0;
x1 = 0;
u1 = 0;
segW = 0;
tt = 0;
expo = 1;
fv = 0;
if (nT >= 2 && nT <= 128) {
    if (segT > nT - 2) {
        segT = 0;
    }
    xs = peek(gwenv, baseT + 1 + segT * 3, 0);
    if (patPh < xs) {
        segT = 0;
    }
    adv = 1;
    for (k = 0; adv > 0 && k < 128; k = k + 1) {
        adv = 0;
        if (segT < nT - 2) {
            xn = peek(gwenv, baseT + 4 + segT * 3, 0);
            if (patPh >= xn) {
                segT = segT + 1;
                adv = 1;
            }
        }
    }
    x0 = peek(gwenv, baseT + 1 + segT * 3, 0);
    u0 = peek(gwenv, baseT + 2 + segT * 3, 0);
    c0 = peek(gwenv, baseT + 3 + segT * 3, 0);
    x1 = peek(gwenv, baseT + 4 + segT * 3, 0);
    u1 = peek(gwenv, baseT + 5 + segT * 3, 0);
    segW = x1 - x0;
    tt = 1;
    if (segW > 0.0000001) {
        tt = clamp((patPh - x0) / segW, 0, 1);
    }
    expo = 1 + 3 * abs(c0);
    fv = pow(tt, expo);
    if (c0 < 0) {
        fv = 1 - pow(1 - tt, expo);
    }
    uT = clamp(u0 + (u1 - u0) * fv, 0, 1);
}

// ---- volume envelope of the active pattern (same evaluation, its own cache) ----
baseV = (actPat * 2 + 1) * blockLen;
nV = peek(gwenv, baseV, 0);
nV = floor(nV);
uV = 0;
xsV = 0;
xnV = 0;
advV = 0;
kV = 0;
x0V = 0;
u0V = 0;
c0V = 0;
x1V = 0;
u1V = 0;
segWV = 0;
ttV = 0;
expoV = 1;
fvV = 0;
if (nV >= 2 && nV <= 128) {
    if (segV > nV - 2) {
        segV = 0;
    }
    xsV = peek(gwenv, baseV + 1 + segV * 3, 0);
    if (patPh < xsV) {
        segV = 0;
    }
    advV = 1;
    for (kV = 0; advV > 0 && kV < 128; kV = kV + 1) {
        advV = 0;
        if (segV < nV - 2) {
            xnV = peek(gwenv, baseV + 4 + segV * 3, 0);
            if (patPh >= xnV) {
                segV = segV + 1;
                advV = 1;
            }
        }
    }
    x0V = peek(gwenv, baseV + 1 + segV * 3, 0);
    u0V = peek(gwenv, baseV + 2 + segV * 3, 0);
    c0V = peek(gwenv, baseV + 3 + segV * 3, 0);
    x1V = peek(gwenv, baseV + 4 + segV * 3, 0);
    u1V = peek(gwenv, baseV + 5 + segV * 3, 0);
    segWV = x1V - x0V;
    ttV = 1;
    if (segWV > 0.0000001) {
        ttV = clamp((patPh - x0V) / segWV, 0, 1);
    }
    expoV = 1 + 3 * abs(c0V);
    fvV = pow(ttV, expoV);
    if (c0V < 0) {
        fvV = 1 - pow(1 - ttV, expoV);
    }
    uV = clamp(u0V + (u1V - u0V) * fvV, 0, 1);
}

// ---- targets: read offset in samples and gain; neutral while stopped ----
// Offsets stay under half the ring, so a grain's distance behind the write head is never ambiguous.
lockOn = 0;
if (pitchlock > 0.5) {
    lockOn = 1;
}
grainS = max(mstosamps(clamp(grainms, 10, 250)), 16);
dep = clamp(depth, 0, 100) * 0.01;
tgtOff = 0;
gainTgt = 1;
if (playing > 0) {
    tgtOff = clamp(uT * dep * patSamps, 0, ringLen * 0.5 - grainS - 16);
    gainTgt = 1 - uV * dep;
}

// ---- a jump in the offset (or switching pitch lock) cross-fades from the old read head ----
smS = max(mstosamps(clamp(smoothms, 0.1, 100)), 1);
jumped = 0;
if (abs(tgtOff - prevTgt) > 16 || lockOn != lockPrev) {
    jumped = 1;
}
if (jumped > 0) {
    if (xfNow >= 0.5) {
        oldOff = prevTgt;
    }
    xfNow = 0;
}

// ---- pitch lock grains: restart at the target, playing forwards, or backwards where the envelope reverses ----
dirNow = dirPrev;
if (jumped == 0) {
    dirNow = 1;
    if (1 - (tgtOff - prevTgt) < -0.05) {
        dirNow = -1;
    }
}
posT = wpos - tgtOff;
gPrev = gPh;
if (jumped > 0) {
    // both grains as if they had been reading towards the new position all along: the output starts exactly there
    gPh = 0;
    gSA = posT;
    gDA = dirNow;
    gSB = posT - dirNow * 0.5 * grainS;
    gDB = dirNow;
} else {
    gPh = gPh + 1 / grainS;
    if (gPh >= 1) {
        gPh = gPh - 1;
        gSA = posT - dirNow * gPh * grainS;
        gDA = dirNow;
    }
    if (gPrev < 0.5 && gPh >= 0.5) {
        gSB = posT - dirNow * (gPh - 0.5) * grainS;
        gDB = dirNow;
    }
}
gPhB = gPh + 0.5;
if (gPhB >= 1) {
    gPhB = gPhB - 1;
}

// ---- record, then read ----
poke(gwring, in1, wpos, 0);
poke(gwring, in2, wpos, 1);

wetNL = 0;
wetNR = 0;
posN = 0;
ipN = 0;
frN = 0;
iN0 = 0;
iNm = 0;
iN1 = 0;
iN2 = 0;
nLm = 0;
nL0 = 0;
nL1 = 0;
nL2 = 0;
nRm = 0;
nR0 = 0;
nR1 = 0;
nR2 = 0;
if (lockOn == 0) {
    posN = wpos - tgtOff;
    ipN = floor(posN);
    frN = posN - ipN;
    iN0 = (ipN + ringLen) % ringLen;
    iNm = (ipN - 1 + ringLen) % ringLen;
    iN1 = (ipN + 1 + ringLen) % ringLen;
    iN2 = (ipN + 2 + ringLen) % ringLen;
    nLm = peek(gwring, iNm, 0);
    nL0 = peek(gwring, iN0, 0);
    nL1 = peek(gwring, iN1, 0);
    nL2 = peek(gwring, iN2, 0);
    nRm = peek(gwring, iNm, 1);
    nR0 = peek(gwring, iN0, 1);
    nR1 = peek(gwring, iN1, 1);
    nR2 = peek(gwring, iN2, 1);
    wetNL = nL0 + (nL1 - nL0) * frN;
    wetNR = nR0 + (nR1 - nR0) * frN;
    if (tgtOff >= 1) {
        wetNL = hermite(nLm, nL0, nL1, nL2, frN);
        wetNR = hermite(nRm, nR0, nR1, nR2, frN);
    }
}

dA = 0;
posA = 0;
ipA = 0;
frA = 0;
iA0 = 0;
iAm = 0;
iA1 = 0;
iA2 = 0;
aLm = 0;
aL0 = 0;
aL1 = 0;
aL2 = 0;
aRm = 0;
aR0 = 0;
aR1 = 0;
aR2 = 0;
gAL = 0;
gAR = 0;
dB = 0;
posB = 0;
ipB = 0;
frB = 0;
iB0 = 0;
iBm = 0;
iB1 = 0;
iB2 = 0;
bLm = 0;
bL0 = 0;
bL1 = 0;
bL2 = 0;
bRm = 0;
bR0 = 0;
bR1 = 0;
bR2 = 0;
gBL = 0;
gBR = 0;
wA = 0;
wB = 0;
if (lockOn > 0) {
    // distance behind the write head, taken modulo the ring to the nearest copy, never ahead of it
    dA = wpos - (gSA + gDA * gPh * grainS);
    dA = max(dA - ringLen * floor(dA / ringLen + 0.5), 0);
    posA = wpos - dA;
    ipA = floor(posA);
    frA = posA - ipA;
    iA0 = (ipA + ringLen) % ringLen;
    iAm = (ipA - 1 + ringLen) % ringLen;
    iA1 = (ipA + 1 + ringLen) % ringLen;
    iA2 = (ipA + 2 + ringLen) % ringLen;
    aLm = peek(gwring, iAm, 0);
    aL0 = peek(gwring, iA0, 0);
    aL1 = peek(gwring, iA1, 0);
    aL2 = peek(gwring, iA2, 0);
    aRm = peek(gwring, iAm, 1);
    aR0 = peek(gwring, iA0, 1);
    aR1 = peek(gwring, iA1, 1);
    aR2 = peek(gwring, iA2, 1);
    gAL = aL0 + (aL1 - aL0) * frA;
    gAR = aR0 + (aR1 - aR0) * frA;
    if (dA >= 1) {
        gAL = hermite(aLm, aL0, aL1, aL2, frA);
        gAR = hermite(aRm, aR0, aR1, aR2, frA);
    }
    dB = wpos - (gSB + gDB * gPhB * grainS);
    dB = max(dB - ringLen * floor(dB / ringLen + 0.5), 0);
    posB = wpos - dB;
    ipB = floor(posB);
    frB = posB - ipB;
    iB0 = (ipB + ringLen) % ringLen;
    iBm = (ipB - 1 + ringLen) % ringLen;
    iB1 = (ipB + 1 + ringLen) % ringLen;
    iB2 = (ipB + 2 + ringLen) % ringLen;
    bLm = peek(gwring, iBm, 0);
    bL0 = peek(gwring, iB0, 0);
    bL1 = peek(gwring, iB1, 0);
    bL2 = peek(gwring, iB2, 0);
    bRm = peek(gwring, iBm, 1);
    bR0 = peek(gwring, iB0, 1);
    bR1 = peek(gwring, iB1, 1);
    bR2 = peek(gwring, iB2, 1);
    gBL = bL0 + (bL1 - bL0) * frB;
    gBR = bR0 + (bR1 - bR0) * frB;
    if (dB >= 1) {
        gBL = hermite(bLm, bL0, bL1, bL2, frB);
        gBR = hermite(bRm, bR0, bR1, bR2, frB);
    }
    // sin^2 windows half a grain apart sum to 1
    wA = sin(3.141592653589793 * gPh);
    wA = wA * wA;
    wB = 1 - wA;
    wetNL = gAL * wA + gBL * wB;
    wetNR = gAR * wA + gBR * wB;
}

wetL = wetNL;
wetR = wetNR;
posO = 0;
ipO = 0;
frO = 0;
iO0 = 0;
iOm = 0;
iO1 = 0;
iO2 = 0;
oLm = 0;
oL0 = 0;
oL1 = 0;
oL2 = 0;
oRm = 0;
oR0 = 0;
oR1 = 0;
oR2 = 0;
wetOL = 0;
wetOR = 0;
aOld = 0;
aNew = 1;
if (xfNow < 1) {
    posO = wpos - oldOff;
    ipO = floor(posO);
    frO = posO - ipO;
    iO0 = (ipO + ringLen) % ringLen;
    iOm = (ipO - 1 + ringLen) % ringLen;
    iO1 = (ipO + 1 + ringLen) % ringLen;
    iO2 = (ipO + 2 + ringLen) % ringLen;
    oLm = peek(gwring, iOm, 0);
    oL0 = peek(gwring, iO0, 0);
    oL1 = peek(gwring, iO1, 0);
    oL2 = peek(gwring, iO2, 0);
    oRm = peek(gwring, iOm, 1);
    oR0 = peek(gwring, iO0, 1);
    oR1 = peek(gwring, iO1, 1);
    oR2 = peek(gwring, iO2, 1);
    wetOL = oL0 + (oL1 - oL0) * frO;
    wetOR = oR0 + (oR1 - oR0) * frO;
    if (oldOff >= 1) {
        wetOL = hermite(oLm, oL0, oL1, oL2, frO);
        wetOR = hermite(oRm, oR0, oR1, oR2, frO);
    }
    // raised cosine: the gains sum to 1, so a fade between heads that carry the same sound does not bump
    aOld = cos(xfNow * 1.5707963267948966);
    aOld = aOld * aOld;
    aNew = 1 - aOld;
    wetL = wetOL * aOld + wetNL * aNew;
    wetR = wetOR * aOld + wetNR * aNew;
}
xfNext = min(xfNow + 1 / smS, 1);

// ---- volume, slewed over the same Smooth time ----
gCoef = 1 - exp(-3 / smS);
gainNow = gainNow + (gainTgt - gainNow) * gCoef;

// ---- mix ----
wetAmt = clamp(wet, 0, 100) * 0.01;
outL = in1 * (1 - wetAmt) + wetL * gainNow * wetAmt;
outR = in2 * (1 - wetAmt) + wetR * gainNow * wetAmt;
out1 = outL;
out2 = outR;

// ---- peaks per 1/256 of the pattern for the editor's waveform ----
pkIn = max(pkIn, max(abs(in1), abs(in2)));
pkOut = max(pkOut, max(abs(outL), abs(outR)));
binNew = clamp(floor(patPh * 256), 0, 255);
if (binNew != binNow) {
    poke(gwpeaks, pkIn, binNow, 0);
    poke(gwpeaks, pkOut, binNow + 256, 0);
    pkIn = 0;
    pkOut = 0;
}

phOut = -1;
if (playing > 0) {
    phOut = patPh;
}
out3 = phOut;
out4 = actPat;

// ---- state for the next sample ----
hWpos = (wpos + 1) % ringLen;
hPrevPh = beatPh;
hInc = incEst;
hStill = stillN;
hBeatCnt = beatCnt;
hSongPrev = songPrev;
hQIdx = qIdx;
hSince = sinceCross;
hReqPrev = reqPat;
hAct = actPat;
hTrig = trigCur;
hTrigMode = trigMode;
hOnPrev = onPrev;
hOffPrev = offPrev;
hSegT = segT;
hSegV = segV;
hPrevTgt = tgtOff;
hOldOff = oldOff;
hXf = xfNext;
hLock = lockOn;
hDir = dirNow;
hGPh = gPh;
hGSA = gSA;
hGSB = gSB;
hGDA = gDA;
hGDB = gDB;
hGain = gainNow;
hBin = binNew;
hPkIn = pkIn;
hPkOut = pkOut;
