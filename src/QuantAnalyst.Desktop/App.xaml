<Application x:Class="QuantAnalyst.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuantAnalyst.Desktop"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:PngToImageConverter x:Key="PngToImage" />
            <local:MarkToBrushConverter x:Key="MarkToBrush" />
            <local:MarkToSoftBrushConverter x:Key="MarkToSoftBrush" />
            <local:InverseVisibilityConverter x:Key="InverseVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
            <local:PageIconConverter x:Key="PageIcon" />
            <BooleanToVisibilityConverter x:Key="Visibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
