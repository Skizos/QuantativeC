<Window x:Class="QuantAnalyst.Desktop.ChartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuantAnalyst.Desktop.Views"
        xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls"
        Title="{Binding Ticker, StringFormat='QuantAnalyst · Charts · {0}'}" Width="1180" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
    <!-- A charts page in a window of its own (docs/plans/12-charts-window.md). It only reads; it closes with the app. -->
    <DockPanel Margin="28,20,28,22">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" Margin="0" VerticalAlignment="Top"
                    ToolTip="Read the instruments and the stored prices again (the prices only while no command runs).">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource IconCharts}" Foreground="White" Width="18" Height="18" StrokeThickness="2" />
                </Border>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                   Visibility="{Binding Message, Converter={StaticResource NonEmptyToVisibility}}" />
        <views:ChartsView />
    </DockPanel>
</Window>
