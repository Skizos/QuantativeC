<Window x:Class="QuantAnalyst.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuantAnalyst.Desktop.Core.ViewModels;assembly=QuantAnalyst.Desktop.Core"
        xmlns:views="clr-namespace:QuantAnalyst.Desktop.Views"
        Title="QuantAnalyst" Width="1200" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StatusViewModel}"><views:StatusView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstrumentsViewModel}"><views:InstrumentsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrategyViewModel}"><views:StrategyView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionViewModel}"><views:SessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name, the mode banner, the login method and the KILL button. Always visible. -->
        <Border Grid.Row="0" Background="{StaticResource Ink}" Padding="16,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="QuantAnalyst" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Kill}" Content="KILL" Command="{Binding KillCommand}" Margin="12,0,0,0"
                        ToolTip="Stop all trading now: a running session halts within a second and cancels every working order." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Login" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding LoginMethods}" SelectedItem="{Binding LoginMethod}" Width="90"
                              IsEnabled="{Binding Engine.IsBusy, Converter={StaticResource InverseBool}}"
                              ToolTip="bankid: approve on your phone. totp: unattended, needs stored credentials (qa secrets set)." />
                </StackPanel>
                <Border Background="#FEF3C7" CornerRadius="4" Padding="10,4" Margin="18,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeBanner}" Foreground="#78350F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0,0,1,0"
                     BorderBrush="{StaticResource Line}" Background="White" Padding="0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="15" Padding="12,10" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The selected page -->
            <DockPanel Grid.Column="1" Margin="24,18,24,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding SelectedPage.RefreshCommand}" />
                        <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedPage.Subtitle}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding SelectedPage.Message}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                               Foreground="{Binding SelectedPage.MessageIsError, Converter={StaticResource ErrorToBrush}}" />
                </StackPanel>
                <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
            </DockPanel>

            <!-- BankID overlay: shown while a login waits for the phone. -->
            <Grid Grid.ColumnSpan="2" Background="#B3111827"
                  Visibility="{Binding Engine.BankId.IsWaiting, Converter={StaticResource Visibility}}">
                <Border Background="White" CornerRadius="8" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <StackPanel>
                        <TextBlock Text="Log in to Avanza with BankID" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                                   Text="Open the BankID app on your phone, choose 'Scan QR code' and scan this code. It changes every second; that is normal." />
                        <Image Source="{Binding Engine.BankId.QrPng, Converter={StaticResource PngToImage}}" Width="300" Height="300"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock Text="{Binding Engine.BankId.Status}" TextWrapping="Wrap" Margin="0,14,0,14" HorizontalAlignment="Center" />
                        <Button Content="Cancel login" Command="{Binding CancelCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom: what runs now, the KILL notice, and the activity log of every command. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White">
            <Expander Padding="12,4" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  ·  Activity log (every command's output)" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Expander.Header>
                <ListBox x:Name="ActivityList" ItemsSource="{Binding Activity}" Style="{StaticResource Console}" Height="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E5E7EB" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#FCA5A5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </Border>
    </Grid>
</Window>
