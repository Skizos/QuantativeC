<Window x:Class="QuantAnalyst.Desktop.PageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls"
        Title="{Binding Title, StringFormat='QuantAnalyst · {0}'}" Width="1200" Height="820" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
    <!-- One page in a window of its own (docs/plans/13-pages-side-by-side.md). It closes with the app. -->
    <DockPanel Margin="28,20,28,22">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" Margin="0" VerticalAlignment="Center"
                    ToolTip="Read everything on this page again from the files the CLI uses.">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <c:Icon Data="{Binding Kind, Converter={StaticResource PageIcon}}" Foreground="White" Width="19" Height="19" StrokeThickness="2.1" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="20" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource PageMessage}" Focusable="False" />
        <ContentControl Content="{Binding}" Focusable="False" />
    </DockPanel>
</Window>
