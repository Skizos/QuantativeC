<UserControl x:Class="QuantAnalyst.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <!-- Your accounts beside the selected one; in a narrow pane the accounts go on top (the list scrolls). -->
    <c:AdaptiveSplit FirstWidth="360" Breakpoint="800" StackedFirstMaxHeight="340" StackedSecondMinHeight="280">
        <DockPanel>
            <!-- The live-trading account (R1). -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="LIVE TRADING ACCOUNT" Style="{StaticResource Overline}" />
                    <Border Style="{StaticResource Chip}" Margin="0,8,0,0" Background="{Binding LiveAccountTone, Converter={StaticResource MarkToSoftBrush}}">
                        <TextBlock Text="{Binding LiveAccountText}" Style="{StaticResource ChipText}" FontSize="13"
                                   Foreground="{Binding LiveAccountTone, Converter={StaticResource MarkToBrush}}" />
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,10"
                               Text="Confirm may send real orders only for this one account (R1). Best: an ISK that holds only what this program trades. Choosing one trades nothing; Confirm still runs every startup check in the terminal." />
                    <Button Content="Stop live trading" Command="{Binding StopLiveCommand}" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0"
                            Foreground="{StaticResource NegativeBrush}"
                            ToolTip="Clears the choice: Confirm refuses to start until you choose an account again." />
                </StackPanel>
            </Border>

            <!-- Your accounts. -->
            <Border Style="{StaticResource Card}" Padding="0,14,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,0,20,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding LoadCommand}" Margin="0"
                                    ToolTip="One Avanza login (BankID or TOTP), then your accounts, values and holdings. Read-only.">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Load" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Your accounts" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding LoadedAt}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource Number}" />
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                Background="{Binding BadgeTone, Converter={StaticResource MarkToSoftBrush}}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}" FontSize="11"
                                                       Foreground="{Binding BadgeTone, Converter={StaticResource MarkToBrush}}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- The selected account. -->
        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding SelectedValue}" Style="{StaticResource Hero}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                    <!-- Choose it for live trading: type the last 3 digits. -->
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"
                            Visibility="{Binding CanChooseSelected, Converter={StaticResource Visibility}}">
                        <c:AdaptiveRow FillMinWidth="220" Spacing="16">
                            <StackPanel c:AdaptiveRow.Fill="True">
                                <TextBlock Text="This account can trade live" Style="{StaticResource H3}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="To make it the one account Confirm may use, type its last 3 digits and press the button." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding ConfirmDigits, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,10,0" MaxLength="3"
                                         ToolTip="The account's last 3 digits, as shown after ***." />
                                <Button Style="{StaticResource Primary}" Content="Use for live trading" Command="{Binding UseForLiveCommand}" Margin="0" />
                            </StackPanel>
                        </c:AdaptiveRow>
                    </Border>

                    <!-- Why it can't. -->
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"
                            Visibility="{Binding SelectedProblems.Count, Converter={StaticResource NonEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Why it can't trade live" Style="{StaticResource H3}" />
                            <ItemsControl ItemsSource="{Binding SelectedProblems}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="HOLDINGS" Style="{StaticResource Overline}" Margin="0,20,0,6" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Holdings}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Name}" Width="2*" MinWidth="110" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Holding" Binding="{Binding Volume}" Width="*" MinWidth="64" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.4*" MinWidth="96" />
                        <DataGridTemplateColumn Header="Gain" Width="1.6*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Gain}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource MarkToBrush}}" />
                                        <TextBlock Text="{Binding GainPct}" Margin="8,0,0,0" Foreground="{Binding Direction, Converter={StaticResource MarkToBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </c:AdaptiveSplit>
</UserControl>
