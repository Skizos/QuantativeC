<UserControl x:Class="QuantAnalyst.Desktop.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <!-- One card, the chart filling it: the controls take three slim rows above it and one below (docs/plans/13). -->
    <Border Style="{StaticResource Card}" Margin="0" Padding="18,14,18,12">
        <DockPanel>
            <!-- Your instruments as chips (the allowlist and any name the running session trades), and a new window. -->
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Command="{Binding OpenWindowCommand}" Margin="12,0,0,0" VerticalAlignment="Top"
                        ToolTip="Opens another chart in a window of its own, e.g. another name or Today next to History. Open as many as you like.">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconWindow}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="New chart window" />
                    </StackPanel>
                </Button>
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Instruments}" SelectedItem="{Binding Selected}" VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ticker}" FontSize="13.5" ToolTip="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The price on one line: ticker, name, last price, change, as of when. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                <TextBlock Text="{Binding Ticker}" Style="{StaticResource H2}" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,8,1" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,20,3" />
                <TextBlock Text="{Binding LastText}" Style="{StaticResource KpiValue}" FontSize="24" VerticalAlignment="Bottom" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,16,3"
                           Foreground="{Binding Direction, Converter={StaticResource MarkToBrush}}" />
                <TextBlock Text="{Binding AsOfText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </WrapPanel>

            <!-- History or Today, the candle length, the range and what is drawn. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Margin="0,0,14,4"
                         ToolTip="History: the stored daily prices. Today: the running Paper session's own quotes, as it trades." />
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Margin="0,0,14,4"
                         ToolTip="How long each candle is.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" Margin="0,0,14,4"
                         Visibility="{Binding IsHistory, Converter={StaticResource Visibility}}"
                         ToolTip="How far back the chart starts. Zoom out with the mouse wheel for older candles.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <CheckBox Content="Volume" IsChecked="{Binding ShowVolume}" Margin="0,0,14,0" VerticalAlignment="Center"
                              Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding IsHistory, Converter={StaticResource Visibility}}" />
                    <CheckBox Content="Averages" IsChecked="{Binding ShowAverages}" Margin="0,0,14,0" VerticalAlignment="Center"
                              Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding IsHistory, Converter={StaticResource Visibility}}" />
                    <CheckBox Content="My trades" IsChecked="{Binding ShowTrades}" VerticalAlignment="Center" Foreground="{StaticResource InkSecondaryBrush}" />
                </StackPanel>
            </WrapPanel>

            <!-- Under the chart: the latest candle's numbers on one line, and what the chart shows (whole on hover). -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <WrapPanel>
                    <TextBlock Text="{Binding StatsTitle}" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ItemsControl ItemsSource="{Binding Stats}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                           ToolTip="{Binding Note}" />
            </StackPanel>

            <c:CandleChart Data="{Binding Chart}" EmptyText="{Binding EmptyText}" MinHeight="420" Margin="0,8,0,0" />
        </DockPanel>
    </Border>
</UserControl>
