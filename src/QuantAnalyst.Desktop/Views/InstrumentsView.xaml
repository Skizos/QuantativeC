<UserControl x:Class="QuantAnalyst.Desktop.Views.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Add an instrument" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                           Text="The ticker as Avanza shows it, e.g. ERIC-B or VOLV-B. Adding imports a year of daily prices (one Avanza login, read-only) and allows the share to be traded. With 5,000 SEK the limit is 500 SEK per order, so shares priced above that can't be bought." />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="6,4" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                    <Button Style="{StaticResource Primary}" Content="Add" Command="{Binding AddCommand}" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" BorderThickness="0"
                      CanUserAddRows="False" SelectionMode="Single" Background="White" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" Width="110" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Orderbook" Binding="{Binding OrderbookId}" Width="110" />
                    <DataGridTextColumn Header="History" Binding="{Binding History}" Width="200" />
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Margin="4,2" Padding="10,2" MinHeight="24"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
