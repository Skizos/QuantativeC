<UserControl x:Class="QuantAnalyst.Desktop.Views.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <!-- The explanation, and the ticker box with Add; in a narrow pane the box moves under the text. -->
            <c:AdaptiveRow FillMinWidth="260" Spacing="24">
                <StackPanel c:AdaptiveRow.Fill="True">
                    <TextBlock Text="Add an instrument" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Adding imports a year of daily prices (one Avanza login, read-only) and allows the share to be traded. With 5 000 kr the limit is 500 kr per order, so a share priced above that can't be bought." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,10,0"
                             ToolTip="The ticker as Avanza shows it, e.g. ERIC-B or VOLV-B." />
                    <Button Style="{StaticResource Primary}" Command="{Binding AddCommand}" IsDefault="True" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconPlus}" Width="16" Height="16" StrokeThickness="2.2" Margin="0,0,6,0" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:AdaptiveRow>
        </Border>

        <!-- The list and the chart side by side; in a narrow pane the list goes on top (it scrolls) and the chart below. -->
        <c:AdaptiveSplit FirstWidth="320" Breakpoint="760" StackedFirstMaxHeight="210" StackedSecondMinHeight="260">
            <!-- The allowlist: pick one to chart it. -->
            <Border Style="{StaticResource Card}" Padding="0,12" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="YOUR INSTRUMENTS" Style="{StaticResource Overline}" Margin="20,0,20,8" />
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource Ghost}" Margin="0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Takes the share off the allowlist. Its stored history stays." />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ticker}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding History}" Style="{StaticResource Caption}" Foreground="{StaticResource InkMutedBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The selected name's chart. -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <c:AdaptiveRow DockPanel.Dock="Top" FillMinWidth="200">
                        <StackPanel c:AdaptiveRow.Fill="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding ChartName}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,2" />
                            </StackPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding LastClose}" Style="{StaticResource Hero}" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding RangeChange}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           Foreground="{Binding RangeDirection, Converter={StaticResource MarkToBrush}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LastCloseDate}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" VerticalAlignment="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </c:AdaptiveRow>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ChartNote}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <c:SeriesChart Data="{Binding Chart}" MinHeight="200" Margin="0,16,0,0" EmptyText="Choose an instrument to see its prices" />
                </DockPanel>
            </Border>
        </c:AdaptiveSplit>
    </DockPanel>
</UserControl>
