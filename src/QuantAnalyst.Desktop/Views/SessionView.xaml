<UserControl x:Class="QuantAnalyst.Desktop.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- When, Start and Stop, and the kill switch. -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Primary}" Command="{Binding StartCommand}"
                            ToolTip="Logs in (BankID or TOTP), updates the history, waits for 09:10, trades on paper until the close.">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconPlay}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" Margin="0"
                            ToolTip="Ends the session early: working orders are cancelled and the partial report is written.">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconStop}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconClock}" Width="18" Height="18" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Schedule}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding KillState}" Style="{StaticResource Caption}" Margin="26,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="26,10,0,0" Visibility="{Binding KillActive, Converter={StaticResource Visibility}}">
                        <TextBox Text="{Binding ResetReason, UpdateSourceTrigger=PropertyChanged}" Width="340" Margin="0,0,10,0"
                                 ToolTip="Why may trading go on? The reason is kept in the audit log." />
                        <Button Content="Clear the kill switch" Command="{Binding ResetKillCommand}"
                                ToolTip="Only while no session runs. The reason is kept in the audit log." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The paper account. -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PAPER ACCOUNT" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding Account}" TextWrapping="Wrap" Style="{StaticResource H3}" Margin="0,4,0,12" />
                <DataGrid ItemsSource="{Binding Positions}" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Ticker}" Width="*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="100" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="160" />
                        <DataGridTextColumn Header="Last fill" Binding="{Binding LastFill}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Session log" Style="{StaticResource H3}" Margin="20,14,20,10" />
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Style="{StaticResource Console}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
