<UserControl x:Class="QuantAnalyst.Desktop.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
            <!-- The paper account's value, day by day. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PAPER ACCOUNT" Style="{StaticResource Overline}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding PaperValue}" Style="{StaticResource Hero}" />
                        <TextBlock Text="{Binding PaperChange}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Bottom" Margin="14,0,0,6"
                                   Foreground="{Binding PaperDirection, Converter={StaticResource MarkToBrush}}" />
                    </StackPanel>
                    <c:SeriesChart Data="{Binding PaperChart}" Height="170" Margin="0,12,0,0" EmptyText="The chart starts after the first Paper session" />
                    <TextBlock Text="{Binding PaperNote}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- The setup, one line per thing a trading day depends on. -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Top"
                                                Background="{Binding Mark, Converter={StaticResource MarkToSoftBrush}}">
                                            <TextBlock Text="{Binding Mark}" Style="{StaticResource ChipText}" Foreground="{Binding Mark, Converter={StaticResource MarkToBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,1,12,0" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,1,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- What to do next, and one button for it. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Next steps" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Primary}" Content="{Binding NextActionLabel}" Command="{Binding NextActionCommand}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
