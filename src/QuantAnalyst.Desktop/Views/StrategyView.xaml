<UserControl x:Class="QuantAnalyst.Desktop.Views.StrategyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Paper trades now: " Style="{StaticResource Hint}" />
                    <TextBlock Text="{Binding Saved}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBlock Text="Strategy" Width="110" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Width="200" />
                </StackPanel>
                <TextBlock Text="{Binding Selected.Summary}" Style="{StaticResource Hint}" Margin="110,0,0,10" />

                <ItemsControl ItemsSource="{Binding Selected.Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding Key}" Width="110" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="6,3" VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Backtest on my instruments" Command="{Binding BacktestCommand}"
                            ToolTip="Replays the strategy on your instruments' history, with Avanza's costs. Every run is logged in the trial ledger." />
                    <Button Style="{StaticResource Primary}" Content="Use for Paper" Command="{Binding SaveCommand}"
                            ToolTip="Saves this strategy in config/paper.json; the Paper session trades it." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Last backtest" FontWeight="SemiBold" Margin="16,12,16,6" />
                <ListBox ItemsSource="{Binding BacktestOutput}" Style="{StaticResource Console}" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
