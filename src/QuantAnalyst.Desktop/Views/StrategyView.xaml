<UserControl x:Class="QuantAnalyst.Desktop.Views.StrategyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QuantAnalyst.Desktop.Controls">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <!-- The form beside what Paper trades now; in a narrow pane that box goes under the form. -->
            <c:AdaptiveRow FillMinWidth="320" Spacing="24" RowSpacing="16">
                <StackPanel c:AdaptiveRow.Fill="True">
                    <TextBlock Text="STRATEGY" Style="{StaticResource Overline}" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="240" HorizontalAlignment="Left" Margin="0,6,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Selected.Summary}" Style="{StaticResource Hint}" Margin="0,0,0,16" />

                    <TextBlock Text="PARAMETERS" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Selected.Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Name and box, the explanation beside them; in a narrow pane under them. -->
                                <c:AdaptiveRow Margin="0,0,0,10" FillMinWidth="180" Spacing="14" RowSpacing="4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" VerticalAlignment="Center" Width="110" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                    </StackPanel>
                                    <StackPanel c:AdaptiveRow.Fill="True" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Foreground="{StaticResource InkMutedBrush}" />
                                    </StackPanel>
                                </c:AdaptiveRow>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Backtest on my instruments" Command="{Binding BacktestCommand}" Margin="0,0,8,6"
                                ToolTip="Replays the strategy on your instruments' history, with Avanza's costs. Every run is logged in the trial ledger." />
                        <Button Style="{StaticResource Primary}" Content="Use for Paper" Command="{Binding SaveCommand}" Margin="0,0,8,6"
                                ToolTip="Saves this strategy in config/paper.json; the Paper session trades it." />
                    </WrapPanel>
                </StackPanel>

                <!-- What Paper trades now. -->
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,12" VerticalAlignment="Top" MinWidth="240" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="PAPER TRADES NOW" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Saved}" Style="{StaticResource H3}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="280" />
                    </StackPanel>
                </Border>
            </c:AdaptiveRow>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Last backtest" Style="{StaticResource H3}" Margin="20,14,20,10" />
                <ListBox ItemsSource="{Binding BacktestOutput}" Style="{StaticResource Console}" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
